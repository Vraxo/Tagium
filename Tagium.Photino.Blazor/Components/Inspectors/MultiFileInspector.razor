@namespace Tagium.Photino.Blazor.Components.Inspectors
@using Tagium.Core.Models
@using Tagium.Core.Services
@using Tagium.Photino.Blazor.Services
@inject LibraryService Library
@inject AppState AppState

<h3>Bulk Edit</h3>
<p class="summary-text">@AppState.SelectedFileIds.Count items selected.</p>

<div class="actions-row">
    <button class="btn btn-danger" @onclick="RemoveMultipleFiles">Remove All Selected</button>
</div>

<hr />

<h4>Common Tags</h4>
<p class="help-text">Click to remove from all selected files.</p>
<div class="tags-container">
    @if (CommonTags.Any())
    {
        @foreach (var tag in CommonTags)
        {
            <span class="tag-pill" @onclick="() => BulkRemoveTag(tag.Id)">
                @tag.Name <span class="remove">&times;</span>
            </span>
        }
    }
    else
    {
        <span class="empty-tag">No common tags.</span>
    }
</div>

<hr />

<h4>Add Tag</h4>
<p class="help-text">Click to add to all selected files.</p>
<div class="tags-container available">
    @foreach (var tag in AvailableTags)
    {
        <span class="tag-pill add" @onclick="() => BulkAddTag(tag.Id)">
            + @tag.Name
        </span>
    }
</div>

<style>
    .summary-text {
        color: #bbb;
        margin-bottom: 10px;
    }

    .help-text {
        font-size: 0.8em;
        color: #888;
        margin: -5px 0 10px 0;
    }

    .actions-row {
        display: flex;
        gap: 5px;
        margin-bottom: 15px;
    }

    .btn {
        background: #444;
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9em;
        flex: 1;
    }

        .btn:hover {
            background: #555;
        }

    .btn-danger {
        background: #c62828;
    }

        .btn-danger:hover {
            background: #d32f2f;
        }

    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .empty-tag {
        color: #666;
        font-style: italic;
        font-size: 0.9em;
    }

    .tag-pill {
        background: #444;
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 0.9em;
        cursor: pointer;
        display: flex;
        align-items: center;
        user-select: none;
    }

        .tag-pill:hover {
            background: #555;
        }

        .tag-pill .remove {
            margin-left: 5px;
            color: #ef5350;
            font-weight: bold;
        }

        .tag-pill.add {
            background: #2a2a2a;
            border: 1px dashed #555;
        }

            .tag-pill.add:hover {
                background: #42a5f5;
                border-color: transparent;
                color: white;
            }
</style>

@code {
    [Parameter] public List<Tag> CommonTags { get; set; } = [];
    [Parameter] public List<Tag> AvailableTags { get; set; } = [];

    private void BulkAddTag(long tagId)
    {
        Library.AddTagToFiles(AppState.SelectedFileIds, tagId);
    }

    private void BulkRemoveTag(long tagId)
    {
        Library.RemoveTagFromFiles(AppState.SelectedFileIds, tagId);
    }

    private void RemoveMultipleFiles()
    {
        Library.RemoveFiles(AppState.SelectedFileIds);
        AppState.ClearSelection();
    }
}