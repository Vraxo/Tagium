@namespace Tagium.Photino.Blazor.Components.Inspectors
@inject LibraryService Library

<div class="single-file-inspector">
    <div class="inspector-header">
        <h3 class="file-name">@File.Name</h3>
        <p class="file-path">@File.Path</p>
    </div>

    <div class="inspector-preview">
        @if (IsImage)
        {
            <img src="tagium://preview/@File.Id" alt="@File.Name" />
        }
        else if (IsVideo)
        {
            <video src="tagium://preview/@File.Id" controls></video>
        }
        else
        {
            <div class="generic-file-preview">📄</div>
        }
    </div>

    <div class="inspector-tags">
        <h4>Tags</h4>
        <div class="tag-pills">
            @foreach (var tag in AssignedTags)
            {
                <span class="tag-pill" style="background-color: @tag.ColorHex">
                    @if (!string.IsNullOrEmpty(tag.Emoji))
                    {
                        <span>@tag.Emoji</span>
                    }
                    @tag.Name
                    <button class="btn-remove-tag" @onclick="() => RemoveTag(tag.Id)">✕</button>
                </span>
            }
        </div>

        @if (AvailableTags.Count > 0)
        {
            <div class="add-tag-section">
                <select @onchange="@(e => { if (Guid.TryParse(e.Value?.ToString(), out var tid)) AddTag(tid); })">
                    <option value="">Add tag...</option>
                    @foreach (var tag in AvailableTags)
                    {
                        <option value="@tag.Id">@tag.Name</option>
                    }
                </select>
            </div>
        }
    </div>

    <div class="inspector-actions">
        <button class="btn btn-secondary" @onclick="OpenFile">Open File</button>
        <button class="btn btn-secondary" @onclick="ShowInExplorer">Show in Explorer</button>
    </div>
</div>