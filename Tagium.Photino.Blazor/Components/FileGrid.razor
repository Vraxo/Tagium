@namespace Tagium.Photino.Blazor.Components
@using Tagium.Core.Services
@using Tagium.Core.Models
@using Tagium.Core.Settings
@using Tagium.Photino.Blazor.Services
@inject LibraryService Library
@inject AppState AppState
@inject SettingsManager Settings
@inject SystemLauncherService Launcher
@inject IJSRuntime JS

<!-- Removed @onclick="ClearSelection" to prevent conflict with marquee JS -->
<div id="file-grid-container" class="grid-container">
    @foreach (var file in Files)
    {
        bool isSelected = AppState.SelectedFileIds.Contains(file.Id);
        <div class="file-card @(isSelected ? "selected" : "")"
             data-id="@file.Id"
             style="width: @(Settings.Current.ThumbnailSize)px; height: @(Settings.Current.ThumbnailSize + 30)px"
             @onclick="e => OnCardClick(e, file.Id)"
             @ondblclick="e => OnCardDoubleClick(e, file)"
             @onclick:stopPropagation="true">

            <div class="thumbnail">
                <img src="tagium://thumbnail/@file.Id"
                     alt="@file.Name"
                     onerror="this.style.display='none'; this.parentElement.classList.add('broken');" />
                <div class="placeholder-icon">📷</div>
            </div>
            <div class="filename" title="@file.Name">
                @file.Name
            </div>
        </div>
    }
</div>

<style>
    .grid-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-content: flex-start;
        height: 100%;
        overflow-y: auto;
        /* Padding moved here to ensure click-events on edges are captured by the grid container */
        padding: 10px;
        position: relative;
    }

    .file-card {
        background: #313131;
        border: 1px solid #444;
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        user-select: none;
        transition: width 0.1s, height 0.1s;
    }

        .file-card:hover {
            border-color: #666;
        }

        .file-card.selected {
            border-color: #42a5f5;
            box-shadow: 0 0 0 2px rgba(66, 165, 245, 0.3);
        }

    .thumbnail {
        flex: 1;
        background: #222;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            position: relative;
            z-index: 2; /* Sit above placeholder */
        }

    .placeholder-icon {
        position: absolute;
        font-size: 2em;
        color: #444;
        z-index: 1;
    }

    .thumbnail.broken .placeholder-icon {
        color: #666;
    }

    .filename {
        height: 30px;
        line-height: 30px;
        padding: 0 5px;
        font-size: 12px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        background: #2a2a2a;
    }
</style>

@code {
    private List<FileEntry> Files = [];
    private DotNetObjectReference<FileGrid>? _objRef;

    protected override async Task OnInitializedAsync()
    {
        LoadFiles();
        AppState.OnChange += RefreshView;
        Library.LibraryChanged += LoadFiles;
        Settings.SettingsChanged += RefreshView;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("gridInteractions.init", _objRef, "file-grid-container");
        }
    }

    private void RefreshView()
    {
        LoadFiles();
        InvokeAsync(StateHasChanged);
    }

    private void LoadFiles()
    {
        Files = Library.GetFiles(AppState.SearchText, AppState.IsMissingOnly);
        Library.EnsureThumbnails(Files);
        InvokeAsync(StateHasChanged);
    }

    private void OnCardClick(MouseEventArgs e, long id)
    {
        AppState.SelectFile(id, e.CtrlKey, e.ShiftKey);
    }

    private void OnCardDoubleClick(MouseEventArgs e, FileEntry file)
    {
        if (!file.IsMissing)
        {
            Launcher.OpenFile(file.Path);
        }
    }

    [JSInvokable]
    public void SelectFile(long id)
    {
        AppState.SelectFile(id, false, false);
    }

    [JSInvokable]
    public void SelectFiles(long[] ids)
    {
        AppState.SetSelection(ids);
    }

    [JSInvokable]
    public void SelectAll()
    {
        AppState.SetSelection(Files.Select(f => f.Id));
    }

    [JSInvokable]
    public void ClearSelection()
    {
        AppState.ClearSelection();
    }

    [JSInvokable]
    public void OnEnterKey()
    {
        if (AppState.SelectedFileIds.Count == 1)
        {
            long id = AppState.SelectedFileIds.First();
            var file = Files.FirstOrDefault(f => f.Id == id);
            if (file != null && !file.IsMissing)
            {
                Launcher.OpenFile(file.Path);
            }
        }
    }

    [JSInvokable]
    public void OnDeleteKey()
    {
        if (AppState.SelectedFileIds.Any())
        {
            Library.RemoveFiles(AppState.SelectedFileIds);
            AppState.ClearSelection();
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= RefreshView;
        Library.LibraryChanged -= LoadFiles;
        Settings.SettingsChanged -= RefreshView;
        _objRef?.Dispose();
    }
}