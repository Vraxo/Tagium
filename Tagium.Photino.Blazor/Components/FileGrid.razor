@namespace Tagium.Photino.Blazor.Components
@using Tagium.Core.Services
@using Tagium.Core.Models
@using Tagium.Photino.Blazor.Services
@inject LibraryService Library
@inject AppState AppState

<div class="grid-container" @onclick="ClearSelection">
    @foreach (var file in Files)
    {
        bool isSelected = AppState.SelectedFileIds.Contains(file.Id);
        <div class="file-card @(isSelected ? "selected" : "")"
             @onclick="e => OnCardClick(e, file.Id)"
             @onclick:stopPropagation="true">

            <div class="thumbnail">
                <img src="tagium://thumbnail/@file.Id" loading="lazy" />
            </div>
            <div class="filename" title="@file.Name">
                @file.Name
            </div>
        </div>
    }
</div>

<style>
    .grid-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-content: flex-start;
        height: 100%;
        overflow-y: auto;
        padding-right: 5px;
    }

    .file-card {
        width: 120px;
        height: 150px;
        background: #313131;
        border: 1px solid #444;
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        user-select: none;
    }

        .file-card:hover {
            border-color: #666;
        }

        .file-card.selected {
            border-color: #42a5f5;
            box-shadow: 0 0 0 2px rgba(66, 165, 245, 0.3);
        }

    .thumbnail {
        flex: 1;
        background: #222;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .filename {
        height: 30px;
        line-height: 30px;
        padding: 0 5px;
        font-size: 12px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        background: #2a2a2a;
    }
</style>

@code {
    private List<FileEntry> Files = [];

    protected override void OnInitialized()
    {
        LoadFiles();
        AppState.OnChange += RefreshView;
        Library.LibraryChanged += LoadFiles;
    }

    private void RefreshView()
    {
        // If search changed, we reload. If only selection changed, we just re-render.
        // For simplicity, we check if file list needs update in LoadFiles or just re-render.
        // Ideally we differentiate, but here we just re-load for safety on search change.
        LoadFiles();
        InvokeAsync(StateHasChanged);
    }

    private void LoadFiles()
    {
        Files = Library.GetFiles(AppState.SearchText, AppState.IsMissingOnly);
        // Kick off thumbnail generation for these files
        Library.EnsureThumbnails(Files);
        InvokeAsync(StateHasChanged);
    }

    private void OnCardClick(MouseEventArgs e, long id)
    {
        AppState.SelectFile(id, e.CtrlKey, e.ShiftKey);
    }

    private void ClearSelection()
    {
        AppState.ClearSelection();
    }

    public void Dispose()
    {
        AppState.OnChange -= RefreshView;
        Library.LibraryChanged -= LoadFiles;
    }
}