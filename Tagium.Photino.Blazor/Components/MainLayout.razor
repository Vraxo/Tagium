@inherits LayoutComponentBase
@namespace Tagium.Photino.Blazor.Components

<div class="app-container">
    <div class="sidebar">
        <h3>Tagium</h3>
        <!-- Navigation will be added here -->
    </div>
    <div class="main-content">
        @Body
    </div>
</div>

<style>
    body, html {
        margin: 0;
        padding: 0;
        height: 100%;
        font-family: 'Segoe UI', sans-serif;
        background: #252525;
        color: #fff;
    }

    .app-container {
        display: flex;
        height: 100vh;
        overflow: hidden;
    }

    .sidebar {
        width: 250px;
        background: #313131;
        padding: 10px;
        display: flex;
        flex-direction: column;
        border-right: 1px solid #444;
    }

    .main-content {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
    }
</style>