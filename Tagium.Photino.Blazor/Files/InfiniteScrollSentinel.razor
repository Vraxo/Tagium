@namespace Tagium.Photino.Blazor.Files
@implements IDisposable
@inject FileBrowser FileBrowser

@* Rendered after the last file while infinite scroll still has batches left.
   window.libraryScroll (wwwroot/js/libraryScroll.js) observes it and asks .NET for the
   next batch, so scrolling near the end appends files before the user reaches the bottom.
   It subscribes to FileBrowser itself rather than relying on its parent re-rendering. *@
@if (FileBrowser.IsInfiniteScroll)
{
    @if (FileBrowser.HasMoreFiles)
    {
        @* Decorative: the loading state is announced by the library live region. *@
        <div class="infinite-scroll-sentinel"
             data-infinite-scroll-sentinel
             aria-hidden="true">
            <span class="infinite-scroll-spinner" aria-hidden="true"></span>
            <span class="infinite-scroll-text">Loading more files…</span>
        </div>
    }
    else if (FileBrowser.TotalFilesCount > 0)
    {
        <div class="infinite-scroll-end">
            End of @FileBrowser.TotalFilesCount @(FileBrowser.TotalFilesCount == 1 ? "file" : "files")
        </div>
    }
}

@code {
    protected override void OnInitialized()
    {
        FileBrowser.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        FileBrowser.OnChange -= OnStateChanged;
    }
}
