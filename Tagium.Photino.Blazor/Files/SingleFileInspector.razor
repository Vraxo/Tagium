@namespace Tagium.Photino.Blazor.Files

<div class="single-file-inspector">
    <div class="inspector-file-header">
        <h3 class="file-name">@File.Name</h3>
        <p class="file-path">@File.Path</p>
    </div>

    <div class="inspector-preview">
        @if (IsImage)
        {
            <img src="tagium://preview/@File.Id" alt="@File.Name" class="preview-media" />
        }
        else if (IsVideo)
        {
            <video src="@VideoPreviewUrl" controls preload="metadata" class="preview-media"></video>
        }
        else
        {
            <div class="generic-file-preview">
                <i class="fa-solid fa-file"></i>
            </div>
        }
    </div>

    <div class="details-section">
        <h4 class="details-heading">Details</h4>
        <dl class="details-list">
            <div class="detail-row">
                <dt>Type</dt>
                <dd>@TypeLabel</dd>
            </div>
            <div class="detail-row">
                <dt>Size</dt>
                <dd>@FormatHelpers.FormatSize(File.Size)</dd>
            </div>
            <div class="detail-row">
                <dt>Added</dt>
                <dd>@FormatHelpers.FormatUnix(File.DateAdded)</dd>
            </div>
            <div class="detail-row">
                <dt>Modified</dt>
                <dd>@FormatHelpers.FormatUnix(File.ModifiedTime)</dd>
            </div>
            @if (!string.IsNullOrEmpty(File.Hash))
            {
                <div class="detail-row">
                    <dt>Hash</dt>
                    <dd class="hash-cell" title="@File.Hash">@ShortHash(File.Hash)</dd>
                </div>
            }
            @if (!string.IsNullOrEmpty(File.Title))
            {
                <div class="detail-row">
                    <dt>Title</dt>
                    <dd>@File.Title</dd>
                </div>
            }
            @if (!string.IsNullOrEmpty(File.Description))
            {
                <div class="detail-row">
                    <dt>Description</dt>
                    <dd class="desc-cell">@File.Description</dd>
                </div>
            }
        </dl>
    </div>

    <RatingStars FileIds="_fileIds" />

    <TagInspectorPanel FileIds="_fileIds" />

    <div class="inspector-actions">
        <button class="btn btn-secondary" @onclick="OpenFile">Open File</button>
        <button class="btn btn-secondary" @onclick="ShowInExplorer">Show in Explorer</button>
    </div>
</div>