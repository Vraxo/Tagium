@namespace Tagium.Photino.Blazor.Files
@implements IDisposable
@inject LibraryService Library
@inject AppState AppState
@inject SettingsManager Settings
@inject IJSRuntime JS

@{
    List<FileEntry> pagedFiles = AppState.GetPagedFiles().ToList();
    Guid? tabStopId = GetTabStopId(pagedFiles);
}

<div id="file-list-container" class="list-container">
    <table class="file-list"
           role="grid"
           aria-label="Library files"
           aria-multiselectable="true">
        <thead>
            <tr role="row">
                <th role="columnheader" scope="col"><span class="visually-hidden">Thumbnail</span></th>
                <th role="columnheader" scope="col">Name</th>
                <th role="columnheader" scope="col">Path</th>
                <th role="columnheader" scope="col">Tags</th>
                <th role="columnheader" scope="col">Date Added</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var file in pagedFiles)
            {
                bool isSelected = AppState.SelectedFileIds.Contains(file.Id);
                bool hasThumb = ThumbnailService.HasThumbnail(file.Id, file.Hash);
                TriggerThumbnailIfMissing(file, hasThumb);

                <tr @key="file.Id"
                    class="file-row @(isSelected ? "selected" : "")"
                    role="row"
                    aria-selected="@(isSelected ? "true" : "false")"
                    tabindex="@(tabStopId == file.Id ? 0 : -1)"
                    data-id="@file.Id"
                    @onclick="e => OnRowClick(e, file.Id)"
                    @ondblclick="e => OnRowDoubleClick(e, file)"
                    @onkeydown="e => OnRowKeyDown(e, file)">

                    <td class="thumbnail-cell" role="gridcell">
                        <div class="thumbnail @(hasThumb ? "" : "broken")">
                            @if (hasThumb)
                            {
                                <img src="tagium://thumbnail/@file.Id/@(file.Hash ?? "none")" alt="@file.Name" />
                            }
                            else
                            {
                                <div class="placeholder-icon">
                                    <i class="fa-solid fa-image" aria-hidden="true"></i>
                                </div>
                            }
                        </div>
                    </td>
                    <td class="name-cell" role="gridcell" title="@file.Name">@file.Name</td>
                    <td class="path-cell" role="gridcell" title="@file.Path">@file.Path</td>
                    <td class="tags-cell" role="gridcell">
                        @foreach (var tag in file.Tags)
                        {
                            <span class="tag-pill" style="border-color: @tag.ColorHex">@tag.Name</span>
                        }
                    </td>
                    <td class="date-cell" role="gridcell">@FormatDate(file.DateAdded)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
