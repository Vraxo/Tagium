@namespace Tagium.Photino.Blazor.Files

<nav class="pagination-bar" aria-label="File pagination">
    <div class="pagination-info">
        @if (FileBrowser.TotalFilesCount == 0)
        {
            <span>No files</span>
        }
        else if (FileBrowser.IsInfiniteScroll)
        {
            <span>Showing @FileBrowser.VisibleFileCount of @FileBrowser.TotalFilesCount @(FileBrowser.TotalFilesCount == 1 ? "file" : "files")@(FileBrowser.HasMoreFiles ? ", scroll for more" : "")</span>
        }
        else
        {
            <span>Showing @GetStartItemIndex() - @GetEndItemIndex() of @FileBrowser.TotalFilesCount @(FileBrowser.TotalFilesCount == 1 ? "file" : "files")</span>
        }
    </div>

    <label class="page-size-control">
        <span>@(FileBrowser.IsInfiniteScroll ? "Files per batch" : "Files per page")</span>
        <select class="page-size-select" value="@FileBrowser.PageSize" @onchange="OnPageSizeChange">
            @foreach (int size in FilePagination.PageSizes)
            {
                <option value="@size">@size</option>
            }
        </select>
    </label>

    @if (!FileBrowser.IsInfiniteScroll && FileBrowser.TotalPages > 1)
    {
        <div class="pagination-buttons">
            <button class="page-btn ctrl-btn"
                    disabled="@(FileBrowser.CurrentPage == 1)"
                    @onclick="() => GoToPage(FileBrowser.CurrentPage - 1)"
                    title="Previous Page"
                    aria-label="Previous Page">
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </button>

            @foreach (var item in GetPageItems())
            {
                var pageItem = item;
                if (pageItem.PageNumber.HasValue)
                {
                    <button class="page-btn @(pageItem.IsActive ? "active" : "")"
                            aria-current="@(pageItem.IsActive ? "page" : "false")"
                            @onclick="() => GoToPage(pageItem.PageNumber.Value)">
                        @pageItem.DisplayText
                    </button>
                }
                else
                {
                    <span class="pagination-ellipsis">@pageItem.DisplayText</span>
                }
            }

            <button class="page-btn ctrl-btn"
                    disabled="@(FileBrowser.CurrentPage == FileBrowser.TotalPages)"
                    @onclick="() => GoToPage(FileBrowser.CurrentPage + 1)"
                    title="Next Page"
                    aria-label="Next Page">
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </button>
        </div>
    }
</nav>
