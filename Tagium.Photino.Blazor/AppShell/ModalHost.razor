@namespace Tagium.Photino.Blazor.AppShell
@implements IAsyncDisposable
@inject ModalService ModalService

@if (IsVisible)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-container"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tagium-modal-title"
             tabindex="-1"
             @ref="_dialog"
             @onkeydown="HandleKeyDown"
             @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 id="tagium-modal-title">@ModalService.Title</h3>
                <button class="close-btn" title="Close" aria-label="Close dialog" @onclick="Close">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="modal-body">
                @ModalService.Content
            </div>
        </div>
    </div>
}
