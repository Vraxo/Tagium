@namespace Tagium.Photino.Blazor.AppShell
@inject AppState AppState
@inject SettingsManager Settings

<div class="app-toolbar">
    @if (Settings.Current.InterfaceStyle == InterfaceStyle.MacOS)
    {
        <div class="finder-title" aria-hidden="true">@(AppState.CurrentView switch
            {
                AppView.Folders => "Folders",
                AppView.Tags => "Tags",
                _ => "Library"
            })</div>
    }

    <div class="toolbar-left">
        @if (Settings.Current.InterfaceStyle == InterfaceStyle.Windows11)
        {
            <div class="fluent-page-heading">
                <span class="fluent-page-title">@(AppState.CurrentView switch
                    {
                        AppView.Folders => "Folders",
                        AppView.Tags => "Tags",
                        _ => "Files"
                    })</span>
                <span class="fluent-page-subtitle">@(AppState.CurrentView switch
                    {
                        AppView.Folders => "Browse your media by folder",
                        AppView.Tags => "Organize and explore with tags",
                        _ => "Browse and organize your media library"
                    })</span>
            </div>
        }
        else
        {
            <div class="segmented-control">
                <button type="button" class="segment-btn @(AppState.CurrentView == AppView.Files ? "active" : "")"
                        aria-pressed="@(AppState.CurrentView == AppView.Files ? "true" : "false")"
                        @onclick="() => AppState.SwitchView(AppView.Files)">
                    <i class="fa-solid fa-images" aria-hidden="true"></i> Files
                </button>
                <button type="button" class="segment-btn @(AppState.CurrentView == AppView.Folders ? "active" : "")"
                        aria-pressed="@(AppState.CurrentView == AppView.Folders ? "true" : "false")"
                        @onclick="() => AppState.SwitchView(AppView.Folders)">
                    <i class="fa-solid fa-folder-tree" aria-hidden="true"></i> Folders
                </button>
                <button type="button" class="segment-btn @(AppState.CurrentView == AppView.Tags ? "active" : "")"
                        aria-pressed="@(AppState.CurrentView == AppView.Tags ? "true" : "false")"
                        @onclick="() => AppState.SwitchView(AppView.Tags)">
                    <i class="fa-solid fa-tags" aria-hidden="true"></i> Tags
                </button>
            </div>
        }
    </div>

    <div class="toolbar-center">
        @if (AppState.CurrentView == AppView.Files || AppState.CurrentView == AppView.Folders)
        {
            <div class="search-wrapper">
                <SearchInput @ref="SearchInput" />
            </div>
        }
    </div>

    <div class="toolbar-right">
        @if (AppState.CurrentView == AppView.Files || AppState.CurrentView == AppView.Folders)
        {
            @if (Settings.Current.InterfaceStyle == InterfaceStyle.MacOS)
            {
                <div class="finder-view-switch" role="group" aria-label="File view">
                    <button type="button" class="finder-view-button @(Settings.Current.FileViewMode == FileViewMode.Grid ? "active" : "")"
                            @onclick="() => SetViewMode(FileViewMode.Grid)" aria-label="Grid view" title="Grid view"
                            aria-pressed="@(Settings.Current.FileViewMode == FileViewMode.Grid ? "true" : "false")">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="5.5" height="5.5" rx="1"/><rect x="11.5" y="3" width="5.5" height="5.5" rx="1"/><rect x="3" y="11.5" width="5.5" height="5.5" rx="1"/><rect x="11.5" y="11.5" width="5.5" height="5.5" rx="1"/></svg>
                    </button>
                    <button type="button" class="finder-view-button @(Settings.Current.FileViewMode == FileViewMode.List ? "active" : "")"
                            @onclick="() => SetViewMode(FileViewMode.List)" aria-label="List view" title="List view"
                            aria-pressed="@(Settings.Current.FileViewMode == FileViewMode.List ? "true" : "false")">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 5h12M4 10h12M4 15h12"/></svg>
                    </button>
                </div>
            }
            else
            {
                <button type="button" class="btn-icon"
                        @onclick="() => SetViewMode(Settings.Current.FileViewMode == FileViewMode.Grid ? FileViewMode.List : FileViewMode.Grid)"
                        title="@(Settings.Current.FileViewMode == FileViewMode.Grid ? "Switch to List View" : "Switch to Grid View")"
                        aria-label="@(Settings.Current.FileViewMode == FileViewMode.Grid ? "Switch to List View" : "Switch to Grid View")"
                        aria-pressed="@(Settings.Current.FileViewMode == FileViewMode.Grid ? "true" : "false")">
                    @if (Settings.Current.FileViewMode == FileViewMode.Grid)
                    {
                        <i class="fa-solid fa-list" aria-hidden="true"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-table-cells" aria-hidden="true"></i>
                    }
                </button>
            }

            <div class="view-options-wrapper">
                <button type="button" class="btn-icon @(IsMenuOpen ? "active" : "")"
                        @ref="ViewOptionsButton"
                        @onclick="ToggleMenu"
                        title="View options"
                        aria-label="View options"
                        aria-expanded="@(IsMenuOpen ? "true" : "false")">
                    <i class="fa-solid fa-eye" aria-hidden="true"></i>
                </button>

                @if (IsMenuOpen)
                {
                    <div class="view-menu-overlay" @onclick="CloseMenu"></div>
                    <div class="view-menu-dropdown">
                        <div class="menu-section">
                            <label>Sort by</label>
                            <SortControls />
                        </div>
                        <hr />
                        <div class="menu-section">
                            <label>Thumbnail size</label>
                            <ThumbnailSizeSlider />
                        </div>
                        <hr />
                        <div class="menu-section">
                            <button type="button" class="menu-action" @onclick="ShowDuplicates">
                                <i class="fa-solid fa-copy" aria-hidden="true"></i> Find duplicates
                            </button>
                            <button type="button" class="menu-action" @onclick="ShowStats">
                                <i class="fa-solid fa-chart-simple" aria-hidden="true"></i> Library statistics
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="vertical-divider"></div>
        }

        <button type="button" class="btn-icon" @onclick="OpenSettings" title="Settings" aria-label="Settings">
            <i class="fa-solid fa-gear" aria-hidden="true"></i>
        </button>
    </div>
</div>
