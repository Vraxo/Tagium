@namespace Tagium.Photino.Blazor.Tags

@if (ShowIcon)
{
    <span class="tag-icon-slot" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(Tag.Emoji))
        {
            <span class="tag-emoji">@Tag.Emoji</span>
        }
        else if (ShowColor)
        {
            <span class="tag-color" style="--tag-color: @Tag.ColorHex"></span>
        }
    </span>
}

