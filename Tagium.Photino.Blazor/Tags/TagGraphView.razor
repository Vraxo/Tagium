@namespace Tagium.Photino.Blazor.Tags
@implements IAsyncDisposable
@inject LibraryService Library
@inject AppState AppState
@inject IJSRuntime JS

<div class="tag-graph-view">
    <div class="tag-graph-toolbar">
        <label class="tag-graph-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search"
                   placeholder="Find a tag in the graph..."
                   aria-label="Find a tag in the graph"
                   @bind="SearchText"
                   @bind:event="oninput"
                   @bind:after="MarkGraphDirty" />
        </label>
        <label class="tag-graph-threshold">
            <span>Shared files</span>
            <select @bind="MinSharedFiles" @bind:after="MarkGraphDirty" aria-label="Minimum shared files for a relationship">
                <option value="1">1 or more</option>
                <option value="2">2 or more</option>
                <option value="3">3 or more</option>
                <option value="5">5 or more</option>
            </select>
        </label>
        <details class="tag-graph-force-menu">
            <summary><i class="fa-solid fa-sliders" aria-hidden="true"></i> Graph settings</summary>
            <div class="tag-graph-force-options">
                <section class="tag-graph-setting-group" aria-label="Display settings">
                    <h5>Display</h5>
                    <label>
                        <span>Node size</span>
                        <input type="range" min="50" max="180" step="5" @bind="NodeSize" @bind:event="oninput" @bind:after="MarkSettingsDirty" />
                        <output>@NodeSize%</output>
                    </label>
                    <label>
                        <span>Link thickness</span>
                        <input type="range" min="1" max="6" step="1" @bind="LinkThickness" @bind:event="oninput" @bind:after="MarkSettingsDirty" />
                        <output>@LinkThickness</output>
                    </label>
                    <label>
                        <span>Text fade threshold</span>
                        <input type="range" min="0" max="100" step="5" @bind="TextFadeThreshold" @bind:event="oninput" @bind:after="MarkSettingsDirty" />
                        <output>@TextFadeThreshold%</output>
                    </label>
                    <label class="tag-graph-toggle-setting">
                        <input type="checkbox" @bind="ShowArrows" @bind:after="MarkSettingsDirty" />
                        <span>Hierarchy arrows</span>
                    </label>
                </section>
                <section class="tag-graph-setting-group" aria-label="Force settings">
                    <h5>Forces</h5>
                    <label>
                        <span>Center force</span>
                        <input type="range" min="0" max="100" step="5" @bind="CenterForce" @bind:event="oninput" @bind:after="MarkSettingsDirty" />
                        <output>@CenterForce%</output>
                    </label>
                    <label>
                        <span>Repel force</span>
                        <input type="range" min="0" max="100" step="5" @bind="RepelForce" @bind:event="oninput" @bind:after="MarkSettingsDirty" />
                        <output>@RepelForce%</output>
                    </label>
                    <label>
                        <span>Link force</span>
                        <input type="range" min="0" max="100" step="5" @bind="LinkForce" @bind:event="oninput" @bind:after="MarkSettingsDirty" />
                        <output>@LinkForce%</output>
                    </label>
                    <label>
                        <span>Link distance</span>
                        <input type="range" min="40" max="180" step="5" @bind="LinkDistance" @bind:event="oninput" @bind:after="MarkSettingsDirty" />
                        <output>@LinkDistance px</output>
                    </label>
                </section>
            </div>
        </details>
        <span class="tag-graph-summary">@GraphSummary</span>
    </div>

    <div class="tag-graph-canvas" aria-label="Interactive tag relationship graph">
        @if (_isLoading)
        {
            <div class="tag-graph-placeholder">Loading tag relationships…</div>
        }
        else if (_data.Nodes.Count == 0)
        {
            <div class="tag-graph-placeholder">
                <i class="fa-solid fa-circle-nodes" aria-hidden="true"></i>
                <strong>No tags to graph yet</strong>
                <span>Create tags and assign them to files to see their relationships.</span>
            </div>
        }
        else
        {
            <canvas @ref="_canvas"
                    class="tag-graph-renderer"
                    tabindex="0"
                    role="img"
                    aria-label="Interactive tag graph. Node size represents file count. Drag to move tags, drag the background to pan, and scroll to zoom. Use the accessible tag list to browse by keyboard."></canvas>
            <div class="visually-hidden" role="list" aria-label="Tags in the graph">
                @foreach (Tag tag in _data.Nodes)
                {
                    <button type="button" role="listitem" @onclick="() => BrowseTag(tag.Id.ToString())">@tag.Name, @tag.FileCount files</button>
                }
            </div>
        }
    </div>

    <div class="tag-graph-legend">
        <span><i class="legend-node" aria-hidden="true"></i> Node size = files with tag</span>
        <span><i class="legend-line" aria-hidden="true"></i> Shared files</span>
        <span><i class="legend-line hierarchy" aria-hidden="true"></i> Tag hierarchy</span>
        <span class="legend-hint">Click a tag to browse · Drag to arrange · Scroll to zoom</span>
    </div>
</div>
