@namespace Tagium.Photino.Blazor.Tags
@inject LibraryService Library
@inject AppState AppState
@inject SettingsManager Settings

<div class="sidebar-container">
    <div class="sidebar-header">
        <div class="sidebar-header-row">
            <h4>Tags</h4>
            <button @ref="_tagSearchToggle"
                    type="button"
                    class="tag-search-toggle @(IsTagSearchOpen ? "active" : "")"
                    aria-label="@GetTagSearchButtonLabel()"
                    title="@GetTagSearchButtonLabel()"
                    aria-expanded="@(IsTagSearchOpen ? "true" : "false")"
                    aria-controls="tag-sidebar-filter"
                    @onclick="ToggleTagSearch">
                @if (IsTagSearchOpen)
                {
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                }
                else
                {
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                }
            </button>
        </div>

        @if (IsTagSearchOpen)
        {
            <div class="tag-search-container">
                <i class="fa-solid fa-magnifying-glass tag-search-icon" aria-hidden="true"></i>
                <input @ref="_tagSearchInput"
                       id="tag-sidebar-filter"
                       class="tag-search-input"
                       type="search"
                       placeholder="Filter tags..."
                       aria-label="Filter tags by name"
                       autocomplete="off"
                       @bind="TagFilter"
                       @bind:event="oninput"
                       @onkeydown="HandleTagSearchKeyDown" />
                @if (!string.IsNullOrWhiteSpace(TagFilter))
                {
                    <button type="button"
                            class="tag-search-clear"
                            aria-label="Clear tag filter"
                            title="Clear filter"
                            @onclick="ClearTagFilter">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                }
            </div>
        }
    </div>

    <div class="tag-list @GetDisplayModeClass()" role="group" aria-label="Tag filters">
        <div class="tag-item system-item @(IsAllFilesActive ? "active" : "")"
             role="button"
             tabindex="0"
             aria-current="@(IsAllFilesActive ? "true" : "false")"
             @onclick="() => SetSearch(string.Empty)"
             @onkeydown="e => ActivateOnKey(e, () => SetSearch(string.Empty))">
            <i class="fa-solid fa-folder icon folder-accent fa-fw" aria-hidden="true"></i> All Files
        </div>

        <div class="tag-item system-item @(IsMissingActive ? "active" : "")"
             role="button"
             tabindex="0"
             aria-current="@(IsMissingActive ? "true" : "false")"
             @onclick="() => AppState.SetMissingOnly(true)"
             @onkeydown="e => ActivateOnKey(e, () => AppState.SetMissingOnly(true))">
            <i class="fa-solid fa-triangle-exclamation icon warning-accent fa-fw" aria-hidden="true"></i> Missing Files
        </div>

        <hr />

        @foreach (var tag in FilteredTags)
        {
            bool isActive = AppState.SearchText.Equals(tag.Name, StringComparison.OrdinalIgnoreCase)
            && !AppState.IsMissingOnly
            && AppState.CurrentView == AppView.Files;

            if (Settings.Current.TagSidebarStyle == TagSidebarDisplayMode.MinimalCircle)
            {
                <div class="tag-item legacy @(isActive ? "active" : "")"
                     role="button"
                     tabindex="0"
                     aria-current="@(isActive ? "true" : "false")"
                     @onclick="() => SetSearch(tag.Name)"
                     @onkeydown="e => ActivateOnKey(e, () => SetSearch(tag.Name))">
                    <TagIcon Tag="@tag" />
                    <span class="name">@tag.Name</span>
                    <span class="count">@tag.FileCount</span>
                </div>
            }
            else
            {
                <div class="tag-item pill @(isActive ? "active" : "")"
                     role="button"
                     tabindex="0"
                     aria-current="@(isActive ? "true" : "false")"
                     @onclick="() => SetSearch(tag.Name)"
                     @onkeydown="e => ActivateOnKey(e, () => SetSearch(tag.Name))"
                     style="--tag-color: @tag.ColorHex; --tag-on-color: @TagColorContrast.GetTextColor(tag.ColorHex);">
                    <TagIcon Tag="@tag" ShowColor="false" />
                    <span class="name">@tag.Name</span>
                    <span class="count">@tag.FileCount</span>
                </div>
            }
        }

        @if (HasNoTagSearchResults)
        {
            <div class="tag-filter-empty" role="status">No matching tags.</div>
        }
    </div>
</div>
