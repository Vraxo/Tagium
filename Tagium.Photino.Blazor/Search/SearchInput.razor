@namespace Tagium.Photino.Blazor.Search
@implements IDisposable

<div class="search-box" @onkeydown="OnBoxKeyDown">
    <svg class="finder-search-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m12.5 12.5 4 4"/></svg>
    <input type="text"
           class="search-input"
           placeholder="Search files..."
           value="@_value"
           @oninput="OnInput"
           @onkeydown="OnInputKeyDown"
           @onfocus="OnFocus"
           @onblur="OnBlur"
           @ref="_inputElement"
           aria-label="Search files" />

    <button type="button"
            class="search-help-toggle"
            title="Search syntax"
            aria-label="Search syntax help"
            aria-expanded="@(_showHelp ? "true" : "false")"
            @onclick="ToggleHelp">
        <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
    </button>

    @if (_showHelp)
    {
        <div class="search-help" role="group" aria-label="Search syntax">
            <p class="search-help-summary">@SearchSyntaxHelp.Summary</p>

            @foreach (SearchHelpTopic topic in SearchSyntaxHelp.Topics)
            {
                <div class="search-help-row">
                    <code class="search-help-syntax">@topic.Syntax</code>
                    <span class="search-help-description">@topic.Description</span>
                </div>
            }
        </div>
    }

    @if (ShowSuggestions)
    {
        @* Real buttons rather than an ARIA combobox: Tab reaches them, Enter or Space applies
           one, and there is no custom arrow-key model to keep in sync with the input. *@
        <div class="search-history" role="group" aria-label="Recent searches">
            @foreach (string suggestion in Suggestions)
            {
                <button type="button"
                        class="search-history-item"
                        @onclick="() => ApplySuggestion(suggestion)"
                        title="@suggestion">
                    <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
                    <span class="search-history-text">@suggestion</span>
                </button>
            }
        </div>
    }
</div>
